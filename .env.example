# ============================================================================
# Brightspace Manager — environment configuration
# All values are OPTIONAL. With nothing set, the app runs fully in mock mode
# and every page shows a "mock data" banner.
# Secrets are server-only: nothing here is ever sent to the browser.
# ============================================================================

# --- Brightspace (D2L) ------------------------------------------------------
# Tenant base URL (no trailing slash).
BRIGHTSPACE_BASE_URL=https://mlri.brightspace.com

# OAuth 2.0 app credentials from Admin Tools > Manage Extensibility.
# After filling these in, run `npm run authorize` once to mint tokens
# (saved to .brightspace-tokens.json, auto-refreshed from then on).
BRIGHTSPACE_CLIENT_ID=
BRIGHTSPACE_CLIENT_SECRET=

# Must EXACTLY match a redirect URI registered for the OAuth app.
BRIGHTSPACE_REDIRECT_URI=https://localhost:3000/callback

# Space-delimited scopes; must be a subset of what the OAuth app registers.
BRIGHTSPACE_SCOPE=core:*:* users:userdata:read organizations:organization:read

# Where minted tokens live (gitignored).
BRIGHTSPACE_TOKEN_FILE=

# Optional long-lived bearer token override for development/testing —
# when set it is used instead of the token file.
BRIGHTSPACE_ACCESS_TOKEN=

# Valence API versions (treated as configurable, not assumed final).
BRIGHTSPACE_LP_VERSION=1.49
BRIGHTSPACE_LE_VERSION=1.82

# Org unit type IDs (see {base}/d2l/api/lp/{v}/outypes/). MLRI tenant:
# Course Offering=3 (D2L built-in), State=103, Program=101 (custom).
BRIGHTSPACE_COURSE_OFFERING_TYPE_ID=3
BRIGHTSPACE_STATE_TYPE_ID=103
BRIGHTSPACE_PROGRAM_TYPE_ID=101

# --- Supabase ----------------------------------------------------------------
# Project URL is safe to expose; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in (Supabase Auth) ---------------------------------------------------
# Publishable anon key (Dashboard > Settings > API). Safe to expose; it only
# grants what Row Level Security allows, and this app reads data exclusively
# through its own server routes, so the anon key is used for sign-in alone.
# When BOTH the URL above and this key are set, the app requires sign-in;
# leave blank to run open in mock/dev mode.
# Dashboard setup: Authentication > Sign In / Up > disable "Allow new users
# to sign up", then invite each colleague's email under Authentication > Users.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Course Studio wrapper template -------------------------------------------
# The Studio reads the live wrapper template (course-style.css, course-nav.js,
# Home.html, complete.html) from the brightspace-courses repo. Two sources:
#
# Local disk — the primary machine. Defaults to
# C:\dev\brightspace-courses\Course-Template; override if it lives elsewhere.
# COURSE_TEMPLATE_DIR=
#
# GitHub raw — for Vercel, which has no local filesystem. Set to the raw base
# URL of the Course-Template directory (no trailing slash). When set, this wins
# over COURSE_TEMPLATE_DIR.
# COURSE_TEMPLATE_URL=https://raw.githubusercontent.com/mcreed-mlri/brightspace-course-demo/main/Course-Template
