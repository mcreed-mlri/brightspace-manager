# ============================================================================
# Brightspace Manager — environment configuration
# All values are OPTIONAL. With nothing set, the app runs fully in mock mode
# and every page shows a "mock data" banner.
# Secrets are server-only: nothing here is ever sent to the browser.
# ============================================================================

# --- Brightspace (D2L) ------------------------------------------------------
# Tenant base URL (no trailing slash).
BRIGHTSPACE_BASE_URL=https://mlri.brightspace.com

# OAuth 2.0 app credentials from Admin Tools > Manage Extensibility.
# After filling these in, run `npm run authorize` once to mint tokens
# (saved to .brightspace-tokens.json, auto-refreshed from then on).
BRIGHTSPACE_CLIENT_ID=
BRIGHTSPACE_CLIENT_SECRET=

# Must EXACTLY match a redirect URI registered for the OAuth app.
BRIGHTSPACE_REDIRECT_URI=https://localhost:3000/callback

# Space-delimited scopes; must be a subset of what the OAuth app registers.
BRIGHTSPACE_SCOPE=core:*:* users:userdata:read organizations:organization:read

# Where minted tokens live (gitignored).
BRIGHTSPACE_TOKEN_FILE=

# Optional long-lived bearer token override for development/testing —
# when set it is used instead of the token file.
BRIGHTSPACE_ACCESS_TOKEN=

# Valence API versions (treated as configurable, not assumed final).
BRIGHTSPACE_LP_VERSION=1.49
BRIGHTSPACE_LE_VERSION=1.82

# --- Supabase ----------------------------------------------------------------
# Project URL is safe to expose; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
