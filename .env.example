# ============================================================================
# Brightspace Manager — environment configuration
# All values are OPTIONAL. With nothing set, the app runs fully in mock mode
# and every page shows a "mock data" banner.
# Secrets are server-only: nothing here is ever sent to the browser.
# ============================================================================

# --- Brightspace (D2L) ------------------------------------------------------
# Tenant base URL (no trailing slash).
BRIGHTSPACE_BASE_URL=https://mlri.brightspace.com

# OAuth 2.0 app credentials from Admin Tools > Manage Extensibility.
# Milestone 1 only checks for their presence; the service-user
# (client-credentials) flow lands in a later milestone.
BRIGHTSPACE_CLIENT_ID=
BRIGHTSPACE_CLIENT_SECRET=

# Optional long-lived bearer token for development/testing. If set together
# with BRIGHTSPACE_BASE_URL, health checks will ping the live API.
BRIGHTSPACE_ACCESS_TOKEN=

# Valence API versions (treated as configurable, not assumed final).
BRIGHTSPACE_LP_VERSION=1.49
BRIGHTSPACE_LE_VERSION=1.82

# --- Supabase ----------------------------------------------------------------
# Project URL is safe to expose; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
